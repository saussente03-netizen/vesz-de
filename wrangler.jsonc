{
  "name": "vesz-de",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "VESZ_KV", "id": "WIRD_GLEICH_IN_CLOUDFLARE_ERSETZT" }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "OPENROUTER_MODEL": "openai/gpt-4o-mini"
  }
}
